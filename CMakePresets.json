  "buildPresets": [
    {
      "name": "release",
      "displayName": "Release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug"
    }
  ]
}
