{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (Visual Studio 2022)",
      "description": "Set the CHRONO_DIR environment variable to the folder containing ChronoConfig.cmake, or override Chrono_DIR in a CMakeUserPresets.json.",
